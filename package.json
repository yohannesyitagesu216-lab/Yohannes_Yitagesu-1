{
  "name": "agrovision-ai-advanced",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:ai": "cd ai-service && ../.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "dev:backend": "cd backend && node server.js",
    "dev:frontend": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5500",
    "dev": "concurrently \"npm run dev:ai\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "typecheck": "npm --prefix frontend run typecheck",
    "build": "npm --prefix frontend run build",
    "validate:academy": "npm --prefix frontend run validate:academy",
    "check:backend": "node --check backend/server.js",
    "check:ai": "./.venv/bin/python -m py_compile ai-service/main.py ai-service/model.py",
    "test:smoke": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
